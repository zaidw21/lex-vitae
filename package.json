{
  "name": "daftar",
  "version": "0.1.0",
  "private": true,
  "description": "Daftar: a WhatsApp-first practice OS for Indian professionals (clinics first, then legal and more).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
