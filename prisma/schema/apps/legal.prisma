// Tables owned by the legal app (src/apps/legal). Plain orgId/contactId columns, no relations
// to platform models, so the platform schema never changes for this app.

// A case/matter handled for a client.
model Matter {
  id            String    @id @default(cuid())
  orgId         String
  contactId     String
  title         String
  caseNumber    String?
  cnr           String?
  court         String?
  caseType      String?
  oppositeParty String?
  stage         String?
  status        String    @default("OPEN")
  nextHearingOn DateTime? @db.Date
  createdAt     DateTime  @default(now())

  @@index([orgId, nextHearingOn])
  @@index([orgId, contactId])
}
