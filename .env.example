# Postgres connection string
DATABASE_URL="postgresql://arcus:arcus@localhost:5432/arcus"

# Public base URL, used in WhatsApp links (token status, documents, receipts)
APP_URL="http://localhost:3000"

# debug | info | warn | error
LOG_LEVEL="info"

# WhatsApp provider: "log" (default; messages are recorded in the Outbox but not sent)
# or "meta" (WhatsApp Business Cloud API).
WHATSAPP_PROVIDER="log"
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
